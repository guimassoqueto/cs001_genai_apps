# Copy to .env (make env) and fill in the key. Never commit .env.
ANTHROPIC_API_KEY=""

# --- Optional overrides (defaults shown) ---

# Models offered in the UI/API, and the one used when none is picked
# ANTHROPIC_MODELS="claude-opus-5-5,claude-fable-5-1,claude-sonnet-5-5,claude-haiku-5-5"
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT=120
# ANTHROPIC_MAX_RETRIES=2

# Conversation memory: earlier turns sent with each message
# MEMORY_MAX_TURNS=10

# Response cache: SimpleCache (in-process), RedisCache (shared, needs redis + CACHE_REDIS_URL) or NullCache (off)
# CACHE_TYPE="SimpleCache"
# CACHE_DEFAULT_TIMEOUT=3600
# CACHE_THRESHOLD=500
# CACHE_REDIS_URL="redis://localhost:6379/0"

# SQLite file for conversation memory and A/B results (default: instance/genai_app.sqlite3 in this folder)
# DATABASE="/path/to/genai_app.sqlite3"

# LOG_LEVEL="INFO"
